[Unit]
Description=Strata automation dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
Environment=PLAYWRIGHT_BROWSERS_PATH=__APP_DIR__/.browsers
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/cli.js serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
